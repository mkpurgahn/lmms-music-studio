{
  "name": "@sarutobi-sasuke/lmms-mcp",
  "version": "0.9.1",
  "description": "MCP server that lets an AI agent compose, mix, measure and export game music with stock LMMS 1.2.2",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lmms",
    "music",
    "game-audio",
    "audio",
    "midi",
    "composition"
  ],
  "homepage": "https://github.com/mkpurgahn/lmms-music-studio#readme",
  "bugs": {
    "url": "https://github.com/mkpurgahn/lmms-music-studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkpurgahn/lmms-music-studio.git"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "server.mjs",
    "fathom.mjs",
    "library-server.mjs",
    "catalogue.mjs",
    "audio.mjs",
    "k-weight.mjs",
    "lra.mjs",
    "stereo.mjs",
    "music.mjs",
    "effects.mjs",
    "tools/",
    "tools/studio-ui/",
    "personas/*.json",
    "licences.json",
    "soundfont-lock.json",
    "schema/",
    "!tools/*.test.mjs",
    "!tools/**/*.test.mjs",
    "sound-catalogue.json",
    "skills/",
    ".github/skills/",
    "AGENTS.md",
    ".mcp.example.json",
    ".vscode/mcp.example.json",
    "install-windows.ps1",
    "demo.mjs",
    "test.mjs",
    "verify-*.mjs",
    "docs/",
    "art/",
    "COMPARISON.md",
    "setup-windows.ps1",
    "setup-libraries-windows.ps1",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "lmms-mcp": "server.mjs"
  },
  "scripts": {
    "demo": "node demo.mjs",
    "test": "node .github/scripts/run-tests.mjs",
    "verify": "node verify-exports.mjs && node verify-game-audio.mjs && node verify-studio-e2e.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tonejs/midi": "2.0.28",
    "@xmldom/xmldom": "0.9.12",
    "zod": "4.6.7"
  }
}
